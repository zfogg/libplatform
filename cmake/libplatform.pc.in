prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libplatform
Description: Cross-platform system support library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lplatform
Libs.private: @CMAKE_DL_LIBS@
Cflags: -I${includedir}
