cmake_minimum_required(VERSION 3.20)

foreach(required NM_TOOL OBJECT_LIST_FILE OUTPUT_FILE LIBRARY_NAME PUBLIC_INCLUDE_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()

file(GLOB_RECURSE PUBLIC_HEADERS "${PUBLIC_INCLUDE_DIR}/*.h")
set(PUBLIC_SYMBOLS)
foreach(header IN LISTS PUBLIC_HEADERS)
  file(READ "${header}" HEADER_TEXT)
  string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*/" "" HEADER_TEXT "${HEADER_TEXT}")
  string(REGEX REPLACE "//[^\\r\\n]*" "" HEADER_TEXT "${HEADER_TEXT}")
  string(REPLACE "\n" ";" HEADER_LINES "${HEADER_TEXT}")
  set(FILTERED_HEADER_TEXT "")
  set(SKIP_PREPROCESSOR_CONTINUATION FALSE)
  foreach(line IN LISTS HEADER_LINES)
    if(SKIP_PREPROCESSOR_CONTINUATION)
      if(NOT line MATCHES "\\\\[ \\t]*$")
        set(SKIP_PREPROCESSOR_CONTINUATION FALSE)
      endif()
      continue()
    endif()
    if(line MATCHES "^[ \\t]*#")
      if(line MATCHES "\\\\[ \\t]*$")
        set(SKIP_PREPROCESSOR_CONTINUATION TRUE)
      endif()
      continue()
    endif()
    string(APPEND FILTERED_HEADER_TEXT "${line}\n")
  endforeach()
  set(HEADER_TEXT "${FILTERED_HEADER_TEXT}")
  string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\(" DECLARATIONS "${HEADER_TEXT}")
  foreach(declaration IN LISTS DECLARATIONS)
    string(REGEX REPLACE "[ \\t]*\\($" "" symbol "${declaration}")
    list(APPEND PUBLIC_SYMBOLS "${symbol}")
  endforeach()
endforeach()
list(REMOVE_DUPLICATES PUBLIC_SYMBOLS)

file(STRINGS "${OBJECT_LIST_FILE}" OBJECTS)
list(FILTER OBJECTS INCLUDE REGEX "\\.(obj|o)$")
execute_process(
  COMMAND "${NM_TOOL}" --format=just-symbols --extern-only --defined-only ${OBJECTS}
  OUTPUT_VARIABLE SYMBOLS
  RESULT_VARIABLE RESULT)
if(NOT RESULT EQUAL 0)
  message(FATAL_ERROR "llvm-nm failed with ${RESULT}")
endif()

string(REPLACE "\r\n" "\n" SYMBOLS "${SYMBOLS}")
string(REPLACE "\r" "\n" SYMBOLS "${SYMBOLS}")
string(REPLACE "\n" ";" SYMBOLS "${SYMBOLS}")
set(EXPORTED_SYMBOLS)
foreach(symbol IN LISTS SYMBOLS)
  list(FIND PUBLIC_SYMBOLS "${symbol}" public_index)
  if(NOT public_index EQUAL -1 OR symbol MATCHES "^platform_")
    list(APPEND EXPORTED_SYMBOLS "${symbol}")
  endif()
endforeach()
list(REMOVE_DUPLICATES EXPORTED_SYMBOLS)
list(SORT EXPORTED_SYMBOLS)
list(TRANSFORM EXPORTED_SYMBOLS PREPEND "    ")
list(JOIN EXPORTED_SYMBOLS "\n" EXPORTS)
file(WRITE "${OUTPUT_FILE}" "LIBRARY ${LIBRARY_NAME}\nEXPORTS\n${EXPORTS}\n")
